{
  "name": "veilsend",
  "private": true,
  "version": "0.2.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:site": "vite --config vite.site.config.ts",
    "build:site": "vite build --config vite.site.config.ts && node scripts/check-site-build.mjs",
    "preview:site": "vite preview --config vite.site.config.ts --host 127.0.0.1 --port 1421 --strictPort",
    "test:site": "node --test scripts/site.test.mjs",
    "test": "vitest run --exclude scripts/*.test.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "check:release": "node scripts/release-contract.mjs",
    "check:licenses": "node scripts/generate-third-party-licenses.mjs --check",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "26.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
